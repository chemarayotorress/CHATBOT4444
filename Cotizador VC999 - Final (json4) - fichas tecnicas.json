        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { chat_id: $json.chatId, text: 'Selecciona una opción:', reply_markup: { inline_keyboard: [ [ { text: '⚡ Cotización rápida', callback_data: 'MODE|FAST' }, { text: '🧠 Cotización avanzada', callback_data: 'MODE|AVANZADA' } ], [ { text: '📄 Ficha técnica', callback_data: 'MODE|FICHA' } ] ] } } }}",
        "options": {}
      },
      "id": "a0e7e2c9-1f3c-46b6-96b6-33a5ed5d4f5a",
      "name": "Menú inicial (json4)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        320,
        120
      ]
    },
    {
      "parameters": {
        "functionCode": "const staticData = $getWorkflowStaticData('global');\nif (!staticData.ficha) staticData.ficha = {};\n\nconst chatId = $json.chatId || $json.message?.chat?.id || $json.chat_id;\nconst callback = $json.callback_data || $json.callbackData || $json.data || '';\nconst text = $json.text || $json.message?.text || '';\nconst nombre = $json.nombre_cliente || $json.nombre || $json.userState?.customer?.name || '';\n\nlet action = 'NONE';\nlet modelo = '';\n\nif (callback === 'MODE|FICHA') {\n  staticData.ficha[chatId] = { stage: 'SELECT_MODEL' };\n  action = 'SHOW_CATALOG';\n} else if (callback.startsWith('FICHA_MODEL|')) {\n  modelo = callback.split('|')[1] || '';\n  staticData.ficha[chatId] = { stage: 'ASK_EMAIL', modelo };\n  action = 'MODEL_SELECTED';\n} else if (callback === 'FICHA_EMAIL|SI') {\n  if (!staticData.ficha[chatId]) staticData.ficha[chatId] = {};\n  staticData.ficha[chatId].stage = 'WAIT_EMAIL';\n  action = 'ASK_EMAIL_INPUT';\n} else if (callback === 'FICHA_EMAIL|NO') {\n  if (!staticData.ficha[chatId]) staticData.ficha[chatId] = {};\n  staticData.ficha[chatId].stage = 'DONE';\n  action = 'END';\n} else if (staticData.ficha[chatId]?.stage === 'WAIT_EMAIL' && text) {\n  action = 'EMAIL_PROVIDED';\n}\n\nreturn [\n  {\n    json: {\n      ...$json,\n      chatId,\n      callback,\n      text,\n      action,\n      modelo: modelo || staticData.ficha[chatId]?.modelo || '',\n      nombre,\n      email: text\n    }\n  }\n];"
      },
