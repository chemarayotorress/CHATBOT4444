    {
      "parameters": {
        "jsCode": "/*\n  Guarda catálogo en staticData (cache) para evitar leer Sheets en cada interacción.\n  Soporta /reload.\n*/\n\nconst staticData = this.getWorkflowStaticData('global');\nconst now = Date.now();\n\n// Entradas\nconst machinesRows = $items('Leer DB_Maquinas').map(i => i.json);\nconst optionsRows  = $items('Leer DB_Opciones').map(i => i.json);\nconst preciosRows  = $items('Leer DB_Precios').map(i => i.json);\n\n// Helpers\nconst toNum = (v) => {\n  if (v === null || v === undefined) return 0;\n  const s = String(v).replace(/,/g, '').trim();\n  const n = Number(s);\n  return Number.isFinite(n) ? n : 0;\n};\n\n// Construir catalog\nconst catalog = {};\nfor (const r of machinesRows) {\n  const model = String(r.modelo || '').trim();\n  if (!model) continue;\n  catalog[model] = {\n    modelo: model,\n    nombre: r.nombre || model,\n    precio_base: toNum(r.precio_base),\n    plantilla: r.plantilla || '',\n    opciones: {},\n    precios: {},\n  };\n}\n\n// Mapear precios por máquina/opción (DB_Precios)\nfor (const p of preciosRows) {\n  const model = String(p.modelo || '').trim();\n  if (!model || !catalog[model]) continue;\n  const key = String(p.opcion_key || p.key || '').trim();\n  if (!key) continue;\n  catalog[model].precios[key] = {\n    label: p.label || key,\n    precio: toNum(p.precio),\n    grupo: p.grupo || '',\n    orden: toNum(p.orden),\n  };\n}\n\n// Opciones (DB_Opciones)\n// Nota: aquí solo guardamos estructura; el precio final lo resuelves desde catalog[model].precios\nfor (const o of optionsRows) {\n  const model = String(o.modelo || '').trim();\n  if (!model || !catalog[model]) continue;\n  const step = String(o.step || '').trim();\n  const key  = String(o.key || '').trim();\n  if (!step || !key) continue;\n\n  if (!catalog[model].opciones[step]) catalog[model].opciones[step] = [];\n\n  catalog[model].opciones[step].push({\n    key,\n    label: o.label || key,\n    placeholder: o.placeholder || '',\n    type: o.type || 'toggle',\n    default: String(o.default || '').toLowerCase() === 'true',\n    orden: toNum(o.orden),\n    group: o.group || '',\n  });\n}\n\n// Ordenar\nfor (const model of Object.keys(catalog)) {\n  for (const step of Object.keys(catalog[model].opciones)) {\n    catalog[model].opciones[step].sort((a,b) => (a.orden||0) - (b.orden||0));\n  }\n}\n\nstaticData.catalog = catalog;\nstaticData.catalogLoadedAt = now;\nstaticData.catalog_cached_at = staticData.catalogLoadedAt;\n\nreturn [{ json: { ...$json, catalogLoaded: true, models: Object.keys(catalog).length } }];"
      },
