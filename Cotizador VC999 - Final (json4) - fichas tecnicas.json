    {
      "parameters": {
        "functionCode": "const chatId = $json.chatId;\n\nconst email =\n  $json.quotePayload?.customer?.email ||\n  $json.fastapiBody?.email ||\n  $json.userState?.customer?.email ||\n  '';\n\nconst nombre =\n  $json.quotePayload?.customer?.name ||\n  $json.fastapiBody?.nombre_cliente ||\n  $json.userState?.customer?.name ||\n  '';\n\nconst modelo =\n  $json.quotePayload?.machine ||\n  $json.fastapiBody?.modelo ||\n  $json.userState?.machine ||\n  'N/A';\n\nconst total =\n  $json.quotePayload?.totalPrice ??\n  $json.fastapiBody?.precio_cambiado ??\n  $json.userState?.totalPrice ??\n  '';\n\nconst hasEmail = typeof email === 'string' && email.includes('@');\n\nreturn [{\n  json: {\n    ...$json,\n    chatId,\n    email,\n    nombre,\n    modelo,\n    total,\n    hasEmail,\n  },\n  binary: $binary,\n}];"
      },
