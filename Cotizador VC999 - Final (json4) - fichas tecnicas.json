    {
      "parameters": {
        "functionCode": "const mapping = {\n  MODELO_A: 'https://raw.githubusercontent.com/OWNER_REPO_BRANCH/ruta/modelo_a.pdf',\n  MODELO_B: 'https://raw.githubusercontent.com/OWNER_REPO_BRANCH/ruta/modelo_b.pdf',\n  MODELO_C: 'https://raw.githubusercontent.com/OWNER_REPO_BRANCH/ruta/modelo_c.pdf'\n};\n\nconst modelo = $json.modelo || '';\nconst rawUrlPdf = mapping[modelo] || '';\n\nreturn [{\n  json: {\n    ...$json,\n    modelo,\n    rawUrlPdf\n  }\n}];"
      },
