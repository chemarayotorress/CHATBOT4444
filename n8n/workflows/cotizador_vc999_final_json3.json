    {
      "parameters": {
        "jsCode": "// Normaliza el payload del Telegram Trigger a un esquema común\n// Outputs: { chatId, text, action, raw }\n\nconst raw = $json;\n\n// chat id puede venir en distintas rutas\nconst chatId = raw?.message?.chat?.id ?? raw?.callback_query?.message?.chat?.id ?? raw?.chatId;\n\n// texto/acción\nconst text = raw?.message?.text ?? raw?.callback_query?.data ?? raw?.text ?? '';\n\n// acción de alto nivel\nlet action = 'TEXT';\nif (text === '/start') action = 'START';\nif (text === '/reload') action = 'RELOAD';\n\nreturn [{\n  json: {\n    chatId,\n    text,\n    action,\n    raw,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -700,
