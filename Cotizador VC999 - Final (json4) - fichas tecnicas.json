              "value1": "={{ $json.action }}",
              "operation": "equal",
              "value2": "MODEL_SELECTED"
            },
            {
              "value1": "={{ $json.action }}",
              "operation": "equal",
              "value2": "ASK_EMAIL_INPUT"
            },
            {
              "value1": "={{ $json.action }}",
              "operation": "equal",
              "value2": "EMAIL_PROVIDED"
            },
            {
              "value1": "={{ $json.action }}",
              "operation": "equal",
              "value2": "END"
            }
          ]
        }
      },
